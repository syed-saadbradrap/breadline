# Required for production: free Supabase project (https://supabase.com)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Shared secret so only your POS can pull/accept website orders
POS_API_KEY=change-me-to-a-long-random-string

# PIN for mobile rider portal at /rider (default matches POS rider PIN)
RIDER_PIN=4444

# Web Push (rider phone notifications) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@breadline.com

# Order confirmation emails
# Option A (recommended): Resend + verified domain (https://resend.com/domains)
#   onboarding@resend.dev can ONLY email your Resend account address — not customers.
#   Verify breadline.com, then set EMAIL_FROM=Breadline <orders@breadline.com>
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Breadline <orders@breadline.com>
# Option B (works without domain): Gmail SMTP app password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Breadline <you@gmail.com>
# Restaurant also gets a copy of each order
ORDER_NOTIFY_EMAIL=contact@breadline.com
